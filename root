  .lrow .lt { font-family: var(--disp); font-weight: 700; font-size: 20px; letter-spacing: -.02em; line-height: 1.05; }
  .lrow .lt .em { font-family: var(--script); font-weight: 600; color: var(--accent); font-size: 1.24em; }
  .lrow p { margin: 0; font-size: 15.5px; color: var(--ink-2); line-height: 1.55; }
  .lrow p b { color: var(--ink); font-weight: 600; }
