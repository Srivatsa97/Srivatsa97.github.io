<script>
  // scroll progress bar
  (function(){
    const bar = document.getElementById('progress');
    function upd(){
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const pct = max > 0 ? (h.scrollTop || document.body.scrollTop) / max : 0;
      bar.style.width = (pct * 100) + '%';
    }
    window.addEventListener('scroll', upd, { passive: true });
    window.addEventListener('resize', upd, { passive: true });
    upd();
  })();

  // step-by-step reveal
  (function(){
    if (!document.documentElement.classList.contains('anim')) return; // reduced motion -> everything already visible
    const items = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window)) { items.forEach(el => el.classList.add('shown')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('shown'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
    items.forEach(el => io.observe(el));
    // safety: reveal anything still hidden after load (e.g. already on screen)
    window.addEventListener('load', () => {
      requestAnimationFrame(() => {
        items.forEach(el => { const r = el.getBoundingClientRect(); if (r.top < window.innerHeight && r.bottom > 0) el.classList.add('shown'); });
      });
    });
  })();
</script>
